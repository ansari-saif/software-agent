# Environment template for software-agent (copy to .env on the server — never commit secrets)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=software_agent
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/software_agent

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ANTHROPIC_API_KEY=
DBDIAGRAM_API_TOKEN=
API_BASE_URL=http://localhost:8000

CORS_ORIGINS=https://agent.ansarisaif.com,http://localhost:3000

NEXT_PUBLIC_BACKEND_URL=https://agent-api.ansarisaif.com
NEXT_PUBLIC_WORKER_URL=https://agent-worker.ansarisaif.com
NEXT_PUBLIC_IDE_BASE_DOMAIN=ide.ansarisaif.com

# Clerk (frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

WORKSPACE_ROOT=/data/workspaces
HOST_WORKSPACE_ROOT=/data/software-agent/workspaces
IDE_BASE_DOMAIN=ide.ansarisaif.com
MAX_CONCURRENT_IDE=3
IDE_MEMORY=4g
IDE_CPUS=1
IDE_IDLE_MINUTES=30
IDE_PASSWORD=change-me-ide

SMOKE_SKIP_PUBLIC=0
# Set 1 on dedicated hosts that do not run MediNexPlus
SMOKE_SKIP_MEDINEX=1
