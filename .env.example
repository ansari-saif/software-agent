# software-agent environment template.
# Copy to .env (server: /opt/software-agent/.env, chmod 600). Never commit real values.
# docker-compose.yml fails fast (${VAR:?}) when a required value is missing.

# --- Images (set by scripts/deploy.sh; only override for manual runs) ---------------
GHCR_OWNER=ansari-saif
# IMAGE_TAG=<git sha>

# --- Postgres ----------------------------------------------------------------------
POSTGRES_USER=software_agent
POSTGRES_PASSWORD=
POSTGRES_DB=software_agent
# URL-encode the password if it contains special characters.
# Inside compose the host is `postgres`; for `pnpm dev` on the host use localhost.
DATABASE_URL=postgresql://software_agent:<password>@postgres:5432/software_agent

# --- Service-to-service auth (api, worker, sandbox-controller) ----------------------
# >= 16 chars. Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=

# --- Clerk -------------------------------------------------------------------------
# PEM from Clerk dashboard -> API keys -> JWT public key. Keep it double-quoted with \n.
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Comma-separated origins allowed in the JWT `azp` claim.
CLERK_AUTHORIZED_PARTIES=https://agent.ansarisaif.com,http://localhost:3000
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Public URLs -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://agent-api.ansarisaif.com
NEXT_PUBLIC_SANDBOX_BASE_DOMAIN=sandbox.ansarisaif.com
CORS_ORIGINS=https://agent.ansarisaif.com,http://localhost:3000

# --- Sandboxes (sandbox-controller) -------------------------------------------------
# Production should use a separate registrable domain, e.g. agentsandbox.app.
SANDBOX_BASE_DOMAIN=sandbox.ansarisaif.com
SANDBOX_PROTOCOL=https
# Defaults to ghcr.io/$GHCR_OWNER/software-agent-sandbox:$IMAGE_TAG when empty.
SANDBOX_IMAGE=
MAX_CONCURRENT_SANDBOXES=3
SANDBOX_MEMORY_GB=4
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=512
SANDBOX_IDLE_MINUTES=30
SANDBOX_MAX_AGE_MINUTES=240
# Host path bind-mounted into the controller at /data/workspaces (owned by uid 1000).
HOST_WORKSPACE_ROOT=/data/software-agent/workspaces
CONTROLLER_URL=http://sandbox-controller:7070

# --- Agent (worker) ----------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5
AGENT_MAX_STEPS=40
AGENT_MAX_STEP_TOKENS=16384
AGENT_MAX_RUN_OUTPUT_TOKENS=120000
MAX_CONCURRENT_RUNS=2

# --- Abuse / cost limits (api + worker) ---------------------------------------------
DAILY_TOKEN_QUOTA=2000000
RATE_LIMIT_PER_MINUTE=60

# --- Observability -----------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# --- Ops scripts -------------------------------------------------------------------
# BACKUP_DIR=/var/backups/software-agent
# RCLONE_REMOTE=b2:software-agent-backups
SMOKE_SKIP_PUBLIC=0
# Set 1 on hosts that do not also run MediNexPlus.
SMOKE_SKIP_MEDINEX=1
