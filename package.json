      "js-cookie": ">=3.0.7",
      "jws": ">=3.2.3",
      "path-to-regexp": ">=8.4.0",
      "postcss": ">=8.5.18",
      "protobufjs": ">=7.6.1",
      "proxy-addr": ">=2.0.8",
