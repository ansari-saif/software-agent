{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ES2016",
    "module": "Node16",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
