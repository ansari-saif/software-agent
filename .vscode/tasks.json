{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Postgres",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "--wait", "postgres"],
      "problemMatcher": []
    },
    {
      "label": "Migrate DB",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "db", "migrate"],
      "dependsOn": ["Start Postgres"],
      "problemMatcher": []
    },
    {
      "label": "Start Web",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@repo/web", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start API",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "api", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Worker",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "worker", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Sandbox Controller",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "sandbox-controller", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build Sandbox Image",
      "type": "shell",
      "command": "docker",
      "args": ["build", "-t", "software-agent-sandbox:dev", "apps/sandbox-image"],
      "problemMatcher": []
    },
    {
      "label": "Start Prisma Studio",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "db", "studio"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start All Services",
      "dependsOn": [
        "Start Web",
        "Start API",
        "Start Worker",
        "Start Sandbox Controller"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
